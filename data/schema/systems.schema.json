{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Systeme",
 "type": "object",
 "required": [
  "schema",
  "entries"
 ],
 "properties": {
  "schema": {
   "const": 1
  },
  "entries": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "security",
     "region",
     "celestials",
     "fields"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^sys\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "security": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "region": {
      "type": "string",
      "minLength": 1
     },
     "celestials": {
      "type": "array",
      "minItems": 2,
      "items": {
       "type": "object",
       "required": [
        "id",
        "type",
        "name",
        "au",
        "angleDeg"
       ],
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^cel\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
        },
        "type": {
         "enum": [
          "star",
          "planet",
          "moon",
          "station",
          "belt",
          "gate",
          "anomaly"
         ]
        },
        "subtype": {
         "type": "string"
        },
        "name": {
         "type": "string",
         "minLength": 1
        },
        "au": {
         "type": "number",
         "minimum": 0
        },
        "angleDeg": {
         "type": "number",
         "minimum": 0,
         "maximum": 360
        },
        "parent": {
         "type": "string"
        },
        "fieldId": {
         "type": "string"
        },
        "to": {
         "type": "string"
        },
        "toGate": {
         "type": "string"
        },
        "services": {
         "type": "array",
         "items": {
          "enum": [
           "market",
           "hangar",
           "missions",
           "refinery",
           "industry",
           "shipyard"
          ]
         },
         "minItems": 1,
         "uniqueItems": true
        },
        "owner": {
         "type": "string",
         "pattern": "^corp\\.[a-z0-9_]+$"
        }
       },
       "additionalProperties": false
      }
     },
     "fields": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
       "type": "object",
       "required": [
        "id",
        "kind",
        "asteroidCount",
        "oreWeights",
        "sizeM3",
        "respawnTicks",
        "hidden"
       ],
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^field\\.[a-z0-9_]+\\.[a-z0-9_]+$"
        },
        "kind": {
         "enum": [
          "belt",
          "anomaly",
          "phased"
         ]
        },
        "asteroidCount": {
         "type": "array",
         "items": {
          "type": "integer",
          "minimum": 1
         },
         "minItems": 2,
         "maxItems": 2
        },
        "oreWeights": {
         "type": "object",
         "minProperties": 1,
         "patternProperties": {
          "^ore\\.[a-z0-9_]+$": {
           "type": "number",
           "minimum": 1
          }
         },
         "additionalProperties": false
        },
        "sizeM3": {
         "type": "array",
         "items": {
          "type": "number",
          "minimum": 1
         },
         "minItems": 2,
         "maxItems": 2
        },
        "respawnTicks": {
         "type": "integer",
         "minimum": 1
        },
        "hidden": {
         "type": "boolean"
        },
        "scanDifficulty": {
         "type": "number",
         "minimum": 0,
         "maximum": 1
        }
       },
       "additionalProperties": false
      }
     }
    },
    "additionalProperties": false
   }
  }
 },
 "additionalProperties": false
}
