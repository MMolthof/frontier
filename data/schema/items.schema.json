{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Items",
 "type": "object",
 "required": [
  "schema",
  "entries"
 ],
 "properties": {
  "schema": {
   "const": 1
  },
  "entries": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "volumeM3",
     "basePrice",
     "kind"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^item\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "volumeM3": {
      "type": "number",
      "minimum": 0.001
     },
     "basePrice": {
      "type": "integer",
      "minimum": 1
     },
     "kind": {
      "enum": [
       "mineral",
       "ammo",
       "loot",
       "skillbook"
      ]
     },
     "description": {
      "type": "string"
     }
    },
    "additionalProperties": false
   }
  }
 },
 "additionalProperties": false
}
