{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Skills",
 "type": "object",
 "required": [
  "schema",
  "entries"
 ],
 "properties": {
  "schema": {
   "const": 1
  },
  "entries": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "group",
     "rank",
     "primary",
     "secondary",
     "maxLevel",
     "requires",
     "price",
     "effects"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^skill\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "group": {
      "type": "string",
      "pattern": "^[a-z_]+$"
     },
     "rank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
     },
     "primary": {
      "enum": [
       "intelligence",
       "memory",
       "perception",
       "willpower",
       "charisma"
      ]
     },
     "secondary": {
      "enum": [
       "intelligence",
       "memory",
       "perception",
       "willpower",
       "charisma"
      ]
     },
     "maxLevel": {
      "const": 5
     },
     "requires": {
      "type": "object",
      "patternProperties": {
       "^skill\\.[a-z0-9_]+$": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
       }
      },
      "additionalProperties": false
     },
     "price": {
      "type": "integer",
      "minimum": 0
     },
     "description": {
      "type": "string"
     },
     "effects": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "stat",
        "op",
        "perLevel"
       ],
       "properties": {
        "stat": {
         "type": "string"
        },
        "op": {
         "enum": [
          "add",
          "mul",
          "set"
         ]
        },
        "perLevel": {
         "type": "number"
        },
        "appliesTo": {
         "type": "object",
         "properties": {
          "moduleGroup": {
           "type": "string"
          },
          "oreSkill": {
           "type": "string",
           "pattern": "^skill\\.[a-z0-9_]+$"
          }
         },
         "additionalProperties": false
        }
       },
       "additionalProperties": false
      }
     }
    },
    "additionalProperties": false
   }
  }
 },
 "additionalProperties": false
}
