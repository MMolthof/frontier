{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Missionen",
 "type": "object",
 "required": [
  "schema",
  "entries"
 ],
 "properties": {
  "schema": {
   "const": 1
  },
  "entries": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "level",
     "title",
     "summary",
     "agentCorp",
     "requires",
     "waves",
     "reward",
     "loot"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^msn\\.l[1-4]\\.[a-z0-9_]+$"
     },
     "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
     },
     "title": {
      "type": "string",
      "minLength": 1
     },
     "summary": {
      "type": "string",
      "minLength": 1
     },
     "agentCorp": {
      "type": "string",
      "pattern": "^corp\\.[a-z0-9_]+$"
     },
     "requires": {
      "type": "object",
      "required": [
       "shipCategory",
       "minClass",
       "maxClass",
       "standing"
      ],
      "properties": {
       "shipCategory": {
        "const": "combat"
       },
       "minClass": {
        "enum": [
         "frigate",
         "destroyer",
         "cruiser",
         "battlecruiser",
         "battleship"
        ]
       },
       "maxClass": {
        "enum": [
         "frigate",
         "destroyer",
         "cruiser",
         "battlecruiser",
         "battleship"
        ]
       },
       "standing": {
        "type": "number",
        "minimum": 0
       }
      },
      "additionalProperties": false
     },
     "waves": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
       "type": "object",
       "required": [
        "npcs"
       ],
       "properties": {
        "npcs": {
         "type": "array",
         "minItems": 1,
         "items": {
          "type": "object",
          "required": [
           "id",
           "count"
          ],
          "properties": {
           "id": {
            "type": "string",
            "pattern": "^npc\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
           },
           "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
           }
          },
          "additionalProperties": false
         }
        }
       },
       "additionalProperties": false
      }
     },
     "reward": {
      "type": "object",
      "required": [
       "isk",
       "timeBonusTicks",
       "timeBonusIsk",
       "standing"
      ],
      "properties": {
       "isk": {
        "type": "array",
        "items": {
         "type": "integer",
         "minimum": 1
        },
        "minItems": 2,
        "maxItems": 2
       },
       "timeBonusTicks": {
        "type": "integer",
        "minimum": 1
       },
       "timeBonusIsk": {
        "type": "integer",
        "minimum": 0
       },
       "standing": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       }
      },
      "additionalProperties": false
     },
     "loot": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "item",
        "chance",
        "qty"
       ],
       "properties": {
        "item": {
         "type": "string",
         "pattern": "^item\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
        },
        "chance": {
         "type": "number",
         "minimum": 0,
         "maximum": 1
        },
        "qty": {
         "type": "array",
         "items": {
          "type": "integer",
          "minimum": 1
         },
         "minItems": 2,
         "maxItems": 2
        }
       },
       "additionalProperties": false
      }
     }
    },
    "additionalProperties": false
   }
  }
 },
 "additionalProperties": false
}
